{
  "id": "toyota_tacoma_2016_2023",
  "name": "Toyota Tacoma (3rd Gen)",
  "match": { "make": "Toyota", "model": "Tacoma", "year_min": 2016, "year_max": 2023, "gen": "3rd" },
  "inherits": "j1979_base",
  "assets": { "logo": "toyota_trd", "brand_color": "#EB0A1E" },
  "bus": {
    "physical": "classic",
    "arb_bitrate": 500000,
    "fd_data_bitrate": null,
    "protocol": "iso_tp",
    "req_id": "0x7E0",
    "resp_id": "0x7E8",
    "func_id": "0x7DF",
    "listen_only": false
  },
  "_note": "Toyota 2GR-FKS / AC60 powertrain CAN. Proprietary signals that differ from the universal baseline. Translated 1:1 from the shipped firmware decode. Bit fields are Motorola (MSB-first, J1939 convention): start_bit is the MSB position, so byte N MSB = N*8.",
  "signals": [
    { "key": "rpm",      "kind": "can_broadcast", "can_id": "0x2C4", "start_bit": 0,  "bit_len": 16, "order": "motorola", "scale": 0.25,    "offset": 0, "signed": false, "unit": "",  "decimals": 0, "_src": "((d0<<8)|d1)/4" },
    { "key": "load",     "kind": "can_broadcast", "can_id": "0x2C4", "start_bit": 16, "bit_len": 8,  "order": "motorola", "scale": 0.39216, "offset": 0, "signed": false, "unit": "%", "decimals": 0, "_src": "d2*100/255" },
    { "key": "throttle", "kind": "can_broadcast", "can_id": "0x2C4", "start_bit": 32, "bit_len": 8,  "order": "motorola", "scale": 0.39216, "offset": 0, "signed": false, "unit": "%", "decimals": 0, "_src": "d4*100/255" },
    { "key": "speed",    "kind": "can_broadcast", "can_id": "0x0B4", "start_bit": 40, "bit_len": 16, "order": "motorola", "scale": 0.00621371, "offset": 0, "signed": false, "unit": "mph", "decimals": 0, "_src": "((d5<<8)|d6)*0.621371/100", "_calibration_warning": "scale factor UNVERIFIED vs Toyota spec (0x0B4 wheel-speed commonly 0.05625/0.0625 km/h per bit). Calibrate against a known-speed log before trusting." },

    { "key": "gear", "kind": "can_enum", "can_id": "0x3BC", "start_bit": 0, "bit_len": 8, "order": "motorola", "map": { "0": "P", "1": "R", "2": "N", "*": "D" },
      "_limitation": "Real logic: lever==3 means 'in gear' and the actual 1-6 comes from a SECOND byte (data[2]&0x0F), else 'D'. A single can_enum cannot read two bytes. Needs the v2 'expr'/codec hook OR a multi-field enum. Representing lever-position P/R/N only for now." },
    { "key": "tcc_locked", "kind": "can_broadcast", "can_id": "0x3BC", "start_bit": 31, "bit_len": 1, "order": "motorola", "scale": 1, "offset": 0, "signed": false, "unit": "", "decimals": 0,
      "_limitation": "Real logic is an OR of two bits in different bytes: (data[3]&0x80) || (data[4]&0x01). Single-field decode covers data[3] bit7 only; the second term needs the v2 'expr' hook." },

    { "key": "kclv",   "kind": "obd_poll", "mode": "0x21", "pid": "0xA2", "data_index": 2, "a": 0.1, "b": 0, "c": 0, "clamp_min": 10, "clamp_max": 30, "unit": "", "decimals": 1, "_src": "Toyota proprietary mode 0x21 0xA2; kclv=p[2]*0.1 clamped 10..30" },
    { "key": "knockfb","kind": "obd_poll", "mode": "0x21", "pid": "0xA2", "data_index": 3, "a": 0.1, "b": 0, "c": 0, "signed": true, "signed_width": 8, "unit": "deg", "decimals": 1, "_src": "knockFB=(int8_t)p[3]*0.1" }
  ]
}
